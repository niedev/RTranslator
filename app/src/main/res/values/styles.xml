<resources>
    <style name="Widget.RTranslator.Button" parent="Widget.MaterialComponents.Button">
        <item name="rippleColor">#33000000</item>   <!-- This will make ripple effects dark even if the colorOnPrimary is white -->
    </style>

    <style name="CustomCardViewStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay_card_custom_corners</item>
    </style>

    <style name="ShapeAppearanceOverlay_card_custom_corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="MyThemeOverlay.MaterialComponents.MaterialAlertDialog" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.RTranslator.Dialog.Rounded</item>
        <item name="colorSurface">?attr/colorBackgroundColoredDialog</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="MyThemeOverlay.MaterialComponents.MaterialAlertDialogWithTitle" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">?attr/colorBackground</item>
        <item name="android:windowBackground">@drawable/bg_custom_material_dialog</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="ShapeAppearanceOverlay.RTranslator.Dialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
