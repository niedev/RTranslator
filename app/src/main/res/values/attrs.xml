<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette roles shared by XML layouts and animated controls. -->
    <attr name="rtranslatorBackground" format="color" />
    <attr name="rtranslatorSurfaceRaised" format="color" />
    <attr name="rtranslatorAccentStrong" format="color" />
    <attr name="rtranslatorAccentSoft" format="color" />
    <attr name="rtranslatorTextBody" format="color" />
    <attr name="rtranslatorTextStrong" format="color" />
    <attr name="rtranslatorMuted" format="color" />
    <attr name="rtranslatorDisabled" format="color" />
    <attr name="rtranslatorOutline" format="color" />
    <attr name="rtranslatorLink" format="color" />
    <attr name="rtranslatorSentMessage" format="color" />
    <attr name="rtranslatorWarning" format="color" />
    <attr name="rtranslatorCardStrokeWidth" format="dimension" />

    <declare-styleable name="ResourceManagerView">
        <attr name="modelTitle" format="string" />
        <attr name="modelDescription" format="string" />
        <attr name="modelSize" format="integer" />
        <attr name="state" format="enum">
            <enum name="empty" value="0" />
            <enum name="paused" value="1" />
            <enum name="downloading" value="2" />
            <enum name="downloaded" value="3" />
        </attr>
    </declare-styleable>

    <declare-styleable name="SegmentProgressBar">
        <attr name="backgroundColor" format="color" />
        <attr name="cornerRadius" format="dimension" />
        <attr name="maxProgress" format="float" />

        <!-- Comma-separated hex colors (e.g., "#ffbfbf,#a2fab3,#6faffc") -->
        <attr name="segmentColors" format="reference" />

        <!-- Comma-separated progress values (e.g., "30,40,20") -->
        <attr name="segmentProgresses" format="reference" />
    </declare-styleable>
</resources>